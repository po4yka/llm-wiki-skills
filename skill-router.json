      "requires_web": false,
      "default_mode": "patch-after-evidence"
    },
    {
      "skill": "llm-wiki-conflict-resolver",
      "intents": ["contradictions", "conflicting claims", "resolve lint findings"],
      "depends_on": ["wiki-lint", "llm-wiki-provenance"],
      "next": ["llm-wiki-source-refresh"],
      "write_risk": "medium",
      "requires_web": false,
      "default_mode": "resolution-options"
    },
    {
      "skill": "llm-wiki-eval",
      "intents": ["evaluate usefulness", "retrieval hit rate", "answer reuse", "wiki value"],
      "depends_on": [],
      "next": ["llm-wiki-benchmark-suite", "llm-wiki-eval-tooling", "llm-wiki-critique-audit"],
      "write_risk": "low",
      "requires_web": false,
      "default_mode": "report-only"
    },
    {
      "skill": "llm-wiki-benchmark-suite",
