      "depends_on": ["llm-wiki-eval"],
      "next": ["llm-wiki-eval-tooling", "llm-wiki-critique-audit"],
      "write_risk": "low",
      "requires_web": false,
      "default_mode": "report-only"
    },
    {
      "skill": "llm-wiki-critique-audit",
      "intents": ["arguments against", "what could go wrong", "criticism", "bad fit", "cognitive debt", "consensus smoothing", "context poisoning", "write-only archive", "token burn", "benchmark vacuum"],
      "depends_on": [],
      "next": ["llm-wiki-eval", "llm-wiki-trust-audit", "llm-wiki-provenance", "llm-wiki-security-review"],
      "write_risk": "none",
      "requires_web": false,
      "default_mode": "report-only"
    },
    {
      "skill": "llm-wiki-security-review",
      "intents": ["security review", "data boundaries", "mcp exposure", "skill safety"],
      "depends_on": [],
      "next": ["llm-wiki-model-policy", "llm-wiki-privacy-redactor"],
      "write_risk": "none",
      "requires_web": false,
      "default_mode": "report-only"
    },
    {
      "skill": "llm-wiki-source-refresh",
      "intents": ["stale sources", "refresh current claims", "dead links", "current as of"],
