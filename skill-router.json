{
  "$schema": "./templates/schemas/skill-router.schema.json",
  "version": "0.1.0",
  "default_entrypoints": [
    "llm-wiki-orient",
    "llm-wiki-faq",
    "llm-wiki-choose",
    "llm-wiki-doctor"
  ],
  "routes": [
    {
      "skill": "llm-wiki-orient",
      "intents": ["what is llm-wiki", "explain pattern", "compare with rag", "solution landscape"],
      "depends_on": [],
      "next": ["llm-wiki-faq", "llm-wiki-news-radar", "llm-wiki-choose"],
      "write_risk": "none",
      "requires_web": false,
      "default_mode": "answer"
    },
    {
      "skill": "llm-wiki-faq",
      "intents": ["why needed", "benefits", "evidence", "proof", "obsidian required", "living wiki", "serious criticism", "arguments against", "cognitive debt", "will become slop"],
      "depends_on": [],
      "next": ["llm-wiki-critique-audit", "llm-wiki-choose", "llm-wiki-eval", "llm-wiki-trust-audit"],
      "write_risk": "none",
      "requires_web": false,
      "default_mode": "answer"
    },
    {
      "skill": "llm-wiki-news-radar",
