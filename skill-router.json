      "write_risk": "medium",
      "requires_web": false,
      "default_mode": "publish-plan-first"
    },
    {
      "skill": "llm-wiki-skill-compiler",
      "intents": ["wiki to skill", "compile procedure", "generate skill"],
      "depends_on": [],
      "next": ["llm-wiki-skill-doctor"],
      "write_risk": "medium",
      "requires_web": false,
      "default_mode": "propose-first"
    },
    {
      "skill": "llm-wiki-skill-doctor",
      "intents": ["review skill", "skill smells", "unsafe skill", "quality audit"],
      "depends_on": [],
      "next": [],
      "write_risk": "none",
      "requires_web": false,
      "default_mode": "report-only"
    }
