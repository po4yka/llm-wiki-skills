{
  "name": "llm-wiki-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "npm run validate:skills && npm run validate:manifest && npm run validate:links && npm run validate:agent-safety && npm run validate:skill-smells && npm run validate:claim-anchors && npm run check:examples",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:manifest": "node scripts/validate-skills-manifest.mjs",
    "validate:links": "node scripts/validate-markdown-links.mjs",
    "validate:agent-safety": "node scripts/validate-agent-safety.mjs",
    "validate:skill-smells": "node scripts/validate-skill-smells.mjs",
    "validate:claim-anchors": "node scripts/validate-claim-anchors.mjs",
    "lint:markdown": "npx --yes markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "catalog:generate": "node scripts/generate-skills-catalog.mjs && node scripts/generate-skills-catalog-md.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "redact:preview": "node scripts/redact-preview.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs"
  },
  "devDependencies": {}
}
