{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/llm-wiki/domain-pack-profile.schema.json",
  "title": "LLM-Wiki domain pack apply profile",
  "type": "object",
  "required": ["name", "version", "copy_to", "recommended_workflow", "templates", "initial_prompts"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": { "type": "string" },
    "copy_to": { "type": "string", "minLength": 1 },
    "recommended_workflow": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "initial_prompts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
